    _signalId: 
  - _lineType: 0
    _speakerName: Player
    _content: "\uC5C5\uBB34\uC5D0 \uBC30\uC815\uB41C \uC9C1\uC5C5\uC740 \uC77C\uC774
      \uB05D\uB0A0 \uB54C\uAE4C\uC9C0 \uD574\uACE0\uD560 \uC218 \uC5C6\uB2E4."

  m_Name: Dialogue_Day7_EmployeeIntro_Niamh
  m_EditorClassIdentifier: 
  _id: Dialogue_Day7_EmployeeIntro_Niamh
  _canSkip: 0
  _lines:
  - _lineType: 0
    _speakerName: Niamh
    _content: "\uC548\uB155\uD558\uC138\uC694."
    _portrait: {fileID: -877178110376344000, guid: 19847e8041a667e48889f27c4bc1cec9, type: 3}
    _portraitSide: 2
    _signalId: 
  - _lineType: 0
    _speakerName: Player
    _content: "\uC548\uB155\uD558\uC138\uC694~ \uBC29\uBB38\uD3EC\uC7A5\uC774\uC2E0\uAC00\uC694?
      \uC800\uD76C\uB294 \uBC30\uB2EC\uB9CC \uD558\uACE0 \uC788\uC5B4\uC11C..."
    _portrait: {fileID: 0}
    _portraitSide: 1
    _signalId: 
  - _lineType: 0
    _speakerName: Niamh
    _content: "\uB124? \uC544, \uC800\uB294 \uC54C\uBC14..."
    _portrait: {fileID: -877178110376344000, guid: 19847e8041a667e48889f27c4bc1cec9, type: 3}
    _portraitSide: 2
    _signalId: 
  - _lineType: 0
    _speakerName: Player
    _content: "\uC544!"
    _portrait: {fileID: 0}
    _portraitSide: 1
    _signalId: 
  - _lineType: 0
    _speakerName: Player
    _content: "(\uB9DE\uB2E4, \uC5B4\uC81C \uC54C\uBC14\uBE4C\uC5D0 \uAD6C\uC778\uAE00
      \uC62C\uB838\uC5C8\uC9C0. \uC644\uC804 \uAE4C\uBA39\uACE0 \uC788\uC5C8\uB124)"
    _portrait: {fileID: 0}
    _portraitSide: 1
    _signalId: 
  - _lineType: 0
    _speakerName: Player
    _content: "\uC8C4\uC1A1\uD569\uB2C8\uB2E4! \uC798 \uC624\uC168\uC5B4\uC694, \uB77C\uC774\uB529\uC5D0
      \uC790\uC2E0 \uC788\uC73C\uC2DC\uC8E0?"
    _portrait: {fileID: 0}
    _portraitSide: 1
    _signalId: 
  - _lineType: 0
    _speakerName: Niamh
    _content: "\uB124, \uB208 \uAC10\uACE0\uB3C4 \uB2EC\uB824\uC694~"
    _portrait: {fileID: -877178110376344000, guid: 19847e8041a667e48889f27c4bc1cec9, type: 3}
    _portraitSide: 2
    _signalId: 
  - _lineType: 0
    _speakerName: Player
    _content: "\uC624~~~"
    _portrait: {fileID: 0}
    _portraitSide: 1
    _signalId: 

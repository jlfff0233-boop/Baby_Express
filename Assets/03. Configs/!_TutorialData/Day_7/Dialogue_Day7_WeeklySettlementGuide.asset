  _id: Dialogue_Day7_WeeklySettlementGuide
  _canSkip: 0
  _lines:
  - _lineType: 0
    _speakerName: Player
    _content: "\uBC8C\uC368 \uCCAB \uC8FC\uAC00 \uB05D\uB0AC\uB2E4. \uC8FC\uAC04
      \uACB0\uACFC\uB97C \uD655\uC778\uD574 \uBCF4\uC790."
    _portrait: {fileID: 0}
    _portraitSide: 1
    _signalId: 
  - _lineType: 1
    _speakerName: 
    _content: 
    _portrait: {fileID: 0}
    _portraitSide: 0
    _signalId: Highlight_WeeklyDeliverySummary
  - _lineType: 0
    _speakerName: Player
    _content: "\uC774\uBC88 \uC8FC\uC5D0 \uC815\uC0C1 \uB0A9\uD488\uD55C \uC8FC\uBB38\uACFC
      \uC9C0\uC5F0\uB41C \uC8FC\uBB38\uC744 \uD655\uC778\uD560 \uC218 \uC788\uB2E4."
    _portrait: {fileID: 0}
    _portraitSide: 1
    _signalId: 
  - _lineType: 1
    _speakerName: 
    _content: 
    _portrait: {fileID: 0}
    _portraitSide: 0
    _signalId: Highlight_WeeklyGradeDistribution
  - _lineType: 0
    _speakerName: Player
    _content: "\uC8FC\uBB38 \uD3C9\uAC00\uAC00 \uC5B4\uB5A4 \uB4F1\uAE09\uC73C\uB85C
      \uB098\uC654\uB294\uC9C0\uB3C4 \uD55C\uB208\uC5D0 \uBCFC \uC218 \uC788\uB2E4."
    _portrait: {fileID: 0}
    _portraitSide: 1
    _signalId: 
  - _lineType: 1
    _speakerName: 
    _content: 
    _portrait: {fileID: 0}
    _portraitSide: 0
    _signalId: Highlight_WeeklyRequirementRate
  - _lineType: 0
    _speakerName: Player
    _content: "\uC8FC\uC694 \uC694\uAD6C \uC0AC\uD56D\uC744 \uC5BC\uB9C8\uB098 \uC798
      \uB9DE\uCDC4\uB294\uC9C0\uB3C4 \uAE30\uB85D\uB41C\uB2E4."
    _portrait: {fileID: 0}
    _portraitSide: 1
    _signalId: 
  - _lineType: 1
    _speakerName: 
    _content: 
    _portrait: {fileID: 0}
    _portraitSide: 0
    _signalId: Highlight_WeeklyFinance
  - _lineType: 0
    _speakerName: Player
    _content: "\uD55C \uC8FC \uB3D9\uC548\uC758 \uC218\uC785, \uC9C0\uCD9C, \uC21C\uC774\uC775\uB3C4
      \uC815\uB9AC\uB418\uC5B4 \uC788\uB2E4."
    _portrait: {fileID: 0}
    _portraitSide: 1
    _signalId: 
  - _lineType: 1
    _speakerName: 
    _content: 
    _portrait: {fileID: 0}
    _portraitSide: 0
    _signalId: Highlight_WeeklyBusinessGrade
  - _lineType: 0
    _speakerName: Player
    _content: "\uC774 \uACB0\uACFC\uB97C \uBC14\uD0D5\uC73C\uB85C \uC774\uBC88 \uC8FC
      \uC601\uC5C5 \uD3C9\uAC00\uAC00 \uACB0\uC815\uB41C\uB2E4."
    _portrait: {fileID: 0}
    _portraitSide: 1
    _signalId: 
  - _lineType: 0
    _speakerName: Player
    _content: "\uD3C9\uAC00\uC5D0 \uB530\uB77C \uB2E4\uC74C \uC8FC \uC6B4\uC601\uC5D0
      \uBCC0\uD654\uAC00 \uC0DD\uAE38 \uC218\uB3C4 \uC788\uC73C\uB2C8 \uD655\uC778\uD574
      \uB450\uC790."
    _portrait: {fileID: 0}
    _portraitSide: 1
    _signalId: 

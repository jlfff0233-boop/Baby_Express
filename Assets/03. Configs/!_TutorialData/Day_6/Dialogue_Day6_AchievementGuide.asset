  _id: Dialogue_Day6_AchievementGuide
  _canSkip: 0
  _lines:
  - _lineType: 0
    _speakerName: Player
    _content: "\uC5C5\uC801\uC5D0\uC11C\uB294 \uC774\uB54C\uAE4C\uC9C0 \uB2EC\uC131\uD55C
      \uAE30\uB85D\uC744 \uD655\uC778\uD560 \uC218 \uC788\uB2E4."
    _portrait: {fileID: 0}
    _portraitSide: 1
    _signalId: 
  - _lineType: 1
    _speakerName: 
    _content: 
    _portrait: {fileID: 0}
    _portraitSide: 0
    _signalId: Highlight_AchievementProgress
  - _lineType: 0
    _speakerName: Player
    _content: "\uC544\uC9C1 \uC9C4\uD589 \uC911\uC778 \uC5C5\uC801\uC740 \uD604\uC7AC
      \uC9C4\uD589\uB3C4\uB97C \uD655\uC778\uD560 \uC218 \uC788\uB2E4."
    _portrait: {fileID: 0}
    _portraitSide: 1
    _signalId: 
  - _lineType: 1
    _speakerName: 
    _content: 
    _portrait: {fileID: 0}
    _portraitSide: 0
    _signalId: Highlight_AchievementStage
  - _lineType: 0
    _speakerName: Player
    _content: "\uD55C \uBC88\uC5D0 \uB05D\uB098\uB294 \uC5C5\uC801\uB3C4 \uC788\uACE0,
      \uC5EC\uB7EC \uB2E8\uACC4\uB85C \uC774\uC5B4\uC9C0\uB294 \uC5C5\uC801\uB3C4
      \uC788\uB2E4."
    _portrait: {fileID: 0}
    _portraitSide: 1
    _signalId: 
  - _lineType: 0
    _speakerName: Player
    _content: "\uC77C\uBD80 \uC5C5\uC801\uC740 \uC870\uAC74\uC744 \uC54C\uC544\uB0B4\uAE30
      \uC804\uAE4C\uC9C0 \uC228\uACA8\uC838 \uC788\uC744 \uC218\uB3C4 \uC788\uB2E4."
    _portrait: {fileID: 0}
    _portraitSide: 1
    _signalId: 
  - _lineType: 1
    _speakerName: 
    _content: 
    _portrait: {fileID: 0}
    _portraitSide: 0
    _signalId: Highlight_AchievementReward
  - _lineType: 0
    _speakerName: Player
    _content: "\uB2EC\uC131\uD55C \uC5C5\uC801\uC758 \uBCF4\uC0C1\uC740 \uC9C1\uC811
      \uBC1B\uC544\uC57C \uD55C\uB2E4."
    _portrait: {fileID: 0}
    _portraitSide: 1
    _signalId: 
  - _lineType: 1
    _speakerName: 
    _content: 
    _portrait: {fileID: 0}
    _portraitSide: 0
    _signalId: Highlight_AchievementClaimButton
  - _lineType: 0
    _speakerName: Player
    _content: "\uBC1B\uC744 \uC218 \uC788\uB294 \uBCF4\uC0C1\uC774 \uC788\uC73C\uBA74
      \uCC59\uACA8\uB450\uC790."
    _portrait: {fileID: 0}

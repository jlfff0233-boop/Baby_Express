    _signalId: Intro_ArticleHeader
  - _lineType: 0
    _speakerName: 
    _content: "\uC774\uC81C 900\uC138 \uC2DC\uB300 \uC9C0\uB0AC\uB2E4... 1000\uC138
      \uC2DC\uB300 \uC9C4\uC785"

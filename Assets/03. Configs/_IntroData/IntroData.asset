  - _lineType: 0
    _speakerName: 
    _content: "100% \uC21C\uC218 \uAD6D\uB0B4\uC0B0 \uC7AC\uB8CC \uC0AC\uC6A9!"
    _portrait: {fileID: 0}
    _portraitSide: 0
    _signalId: 
  - _lineType: 0
    _speakerName: 
    _content: "\uBBFF\uACE0 \uD0A4\uC6B8 \uC218 \uC788\uB294 \uB054\uCC0D\uD55C \uC544\uAE30
